# Copy this file to frontend/.env and fill in your Supabase project values.

# Supabase project URL (Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend base URL. Prefer 127.0.0.1 over localhost: on some machines
# localhost resolves to IPv6 ::1 first, where WSL/Docker services squat
# on port 8000 and answer 404 to every API call.
VITE_API_URL=http://127.0.0.1:8000/api
